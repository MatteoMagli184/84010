---
/** Barra fissa su telefono (da mc8): chiamata con un tocco + prenotazione WhatsApp. */
import Icon from './ui/Icon.astro';
import { contact, waBooking } from '@/data/site';
---
<div class="mc-mbar" data-mbar aria-label="Contatto rapido" role="region">
  <a href={contact.phone.href} class="fx-btn mc-mbar-btn mc-mbar-call">
    <span class="btn-label"><Icon name="phone" size={18} /> Chiama</span>
  </a>
  <a href={waBooking} target="_blank" rel="noopener" class="fx-btn mc-mbar-btn mc-mbar-book">
    <span class="btn-label"><Icon name="whatsapp" size={18} /> Prenota</span>
  </a>
</div>

<style>
  .mc-mbar {
    position: fixed;
    z-index: 45;
    left: 0;
    right: 0;
    bottom: 0;
    display: grid;
    grid-template-columns: 1fr 1.25fr;
    gap: 0.5rem;
    padding: 0.6rem 0.75rem calc(0.6rem + env(safe-area-inset-bottom));
    background: rgb(8 8 8 / 0.92);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    box-shadow: 0 -1px 0 rgb(246 183 101 / 0.2), 0 -10px 30px -18px rgb(0 0 0 / 0.6);
    transform: translateY(110%);
    transition: transform 0.45s var(--ease-out);
  }
  .mc-mbar.is-on { transform: translateY(0); }
  .mc-mbar-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 3rem;
    border-radius: var(--radius-btn);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .mc-mbar-call { --shine: rgb(239 229 216 / 0.6); border: 1px solid rgb(255 255 255 / 0.22); color: var(--color-sand); }
  .mc-mbar-book { --shine: rgb(255 255 255 / 0.85); background: linear-gradient(180deg, #e7a868 0%, #c47a35 55%, #a3601f 100%); color: #0b0b0b; box-shadow: inset 0 1px 0 rgb(255 226 190 / 0.55); }
  @media (min-width: 900px) {
    .mc-mbar { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .mc-mbar { transition: none; }
  }
</style>

<script>
  const bar = document.querySelector<HTMLElement>('[data-mbar]');
  if (bar) {
    // Compare dopo l'hero.
    const sync = () => {
      bar.classList.toggle('is-on', window.scrollY > window.innerHeight * 0.6);
    };
    sync();
    let ticking = false;
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => { ticking = false; sync(); });
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
  }
</script>
