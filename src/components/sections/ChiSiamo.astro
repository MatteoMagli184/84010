---
/** Chi siamo (About di mc8): testo del cliente + la foto di Pompei e del Vesuvio (le radici). */
import Section from '../ui/Section.astro';
import Container from '../ui/Container.astro';
import { Image } from 'astro:assets';
import { photos } from '@/data/photos';
import { about } from '@/data/content';
import { rich } from '@/lib/rich';

const [first, ...rest] = about.body;
const radici = photos.pompeiVesuvio;
---
<Section id="chi-siamo" label="Chi siamo">
  <Container>
    <div class="mc-about">
      <div class="mc-about-text">
        <p class="kicker">{about.kicker}</p>
        <h2 class="section-title" set:html={rich(about.title)} />
        <p class="mc-about-lead" data-stagger>{first}</p>
        <div class="mc-about-body" data-reveal>
          {rest.map((p) => <p>{p}</p>)}
        </div>
        <p class="mc-about-sign" data-reveal>{about.sign}</p>
        <ul class="mc-values" data-reveal>
          {about.values.map((v) => <li>{v}</li>)}
        </ul>
      </div>

      <figure class="mc-about-media">
        <div class="mc-about-frame" data-curtain>
          <Image
            src={radici.src}
            alt={radici.alt}
            widths={[480, 720, 940]}
            sizes="(min-width: 1024px) 40vw, 92vw"
            quality={80}
            class="mc-about-img"
            style={`object-position:${radici.pos}`}
          />
        </div>
        <figcaption class="mc-about-caption">{about.photoCaption}</figcaption>
      </figure>
    </div>
  </Container>
</Section>

<style>
  .mc-about {
    display: grid;
    gap: 3.5rem;
    align-items: center;
  }
  @media (min-width: 1024px) {
    .mc-about { grid-template-columns: 1.1fr 0.9fr; gap: 5rem; }
  }
  .mc-about-lead {
    position: relative;
    margin-top: 2.25rem;
    padding-left: 1.75rem;
    border-left: 1px solid rgb(246 183 101 / 0.45);
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(1.3rem, 2.1vw, 1.6rem);
    line-height: 1.5;
    color: var(--color-sand);
  }
  .mc-about-body {
    margin-top: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
    max-width: 58ch;
    font-size: 1.02rem;
    line-height: 1.85;
    color: var(--color-muted);
    font-weight: 300;
  }
  .mc-about-sign {
    margin-top: 2rem;
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.3rem;
    line-height: 1.45;
    color: var(--color-copper-light);
  }
  .mc-values {
    margin-top: 2.25rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem 1.1rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--color-line);
  }
  .mc-values li {
    display: inline-flex;
    align-items: center;
    gap: 1.1rem;
    font-size: 0.64rem;
    font-weight: 500;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--color-sand);
  }
  .mc-values li + li::before {
    content: '';
    width: 5px;
    height: 5px;
    transform: rotate(45deg);
    background: var(--color-copper);
  }
  .mc-about-media { margin: 0; }
  .mc-about-frame {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 6;
    max-height: 46rem;
    border-radius: var(--radius-card);
    background: var(--color-coal);
    box-shadow: 0 50px 90px -45px rgb(0 0 0 / 0.95), 0 0 0 1px rgb(255 255 255 / 0.06);
  }
  @media (max-width: 1023px) {
    .mc-about-frame { aspect-ratio: 4 / 5; }
  }
  .mc-about-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.4s var(--ease-out);
  }
  .mc-about-media:hover .mc-about-img { transform: scale(1.04); }
  .mc-about-caption {
    margin-top: 1rem;
    text-align: center;
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1rem;
    color: var(--color-muted);
  }
</style>
