---
/**
 * Fascia «Per info e prenotazioni» (PreventivoBand di mc8): la carta
 * stropicciata e foto in dissolvenza con parallasse, titolo e CTA sopra.
 */
import { Image } from 'astro:assets';
import Container from '../ui/Container.astro';
import { photos } from '@/data/photos';

const backgrounds = [photos.fiammaForno, photos.salaPareteePietra, photos.pizzaTaglieroForno];
import Icon from '../ui/Icon.astro';
import { prenota } from '@/data/content';
import { contact, waBooking } from '@/data/site';
import { rich } from '@/lib/rich';
---
<section class="mc-band" aria-label="Info e prenotazioni">
  <div class="mc-band-media" data-band aria-hidden="true">
    <span class="mc-band-tex"></span>
    {backgrounds.map((img, i) => (
      <div class="mc-band-slide" data-slide data-active={i === 0 ? '' : undefined}>
        <Image src={img.src} alt="" widths={[768, 1280, 1920]} sizes="100vw" quality={70} loading="lazy" class="mc-band-img" style={`object-position:${img.pos ?? '50% 50%'}`} />
      </div>
    ))}
    <span class="mc-band-glow"></span>
  </div>

  <Container>
    <div class="mc-band-inner">
      <p class="kicker mc-band-kicker">{prenota.kicker}</p>
      <h2 class="section-title mc-band-title" set:html={rich(prenota.title)} />
      <p class="mc-band-lead" data-stagger>{prenota.lead}</p>
      <div class="mc-band-actions">
        <a href={waBooking} target="_blank" rel="noopener" class="btn btn-copper">
          <span class="btn-label"><Icon name="whatsapp" /> WhatsApp {contact.whatsapp.label}</span>
        </a>
        <a href={contact.phone.href} class="btn btn-outline">
          <span class="btn-label"><Icon name="phone" /> Fisso {contact.phone.label}</span>
        </a>
      </div>
    </div>
  </Container>
  <span class="mc-band-flag" aria-hidden="true"></span>
</section>

<style>
  .mc-band {
    position: relative;
    display: flex;
    align-items: center;
    min-height: clamp(30rem, 70vh, 40rem);
    padding-block: var(--spacing-section);
    color: var(--color-sand);
    background: var(--color-night);
    overflow: hidden;
  }
  .mc-band-media { position: absolute; inset: -12% 0; will-change: transform; }
  .mc-band-tex {
    position: absolute;
    inset: 0;
    background: url('/img/carta-stropicciata.webp') center / cover;
    filter: brightness(0.45) saturate(0.2);
  }
  .mc-band-slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 1.6s ease;
  }
  .mc-band-slide[data-active] { opacity: 1; }
  .mc-band-img { width: 100%; height: 100%; object-fit: cover; }
  .mc-band-glow {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(55% 65% at 85% 60%, rgb(190 111 41 / 0.16), transparent 70%),
      linear-gradient(100deg, rgb(8 8 8 / 0.94) 0%, rgb(8 8 8 / 0.75) 50%, rgb(8 8 8 / 0.35) 100%);
  }
  .mc-band-inner { position: relative; z-index: 2; max-width: 42rem; }
  .mc-band-title {
    margin-top: 1.1rem;
    font-size: var(--text-display);
    line-height: 1.06;
  }
  .mc-band-lead {
    margin-top: 1.4rem;
    max-width: 42ch;
    font-size: 1.1rem;
    font-weight: 300;
    opacity: 0.9;
  }
  .mc-band-actions {
    margin-top: 2.25rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  /* Filo tricolore in fondo, come nella grafica dei contatti */
  .mc-band-flag {
    position: absolute;
    left: 50%;
    bottom: 2rem;
    width: min(32rem, 70vw);
    height: 2px;
    transform: translateX(-50%);
    background: linear-gradient(90deg, transparent, #1f8a4c 15%, #1f8a4c 33%, #f3eee6 33%, #f3eee6 67%, #c8242f 67%, #c8242f 85%, transparent);
    opacity: 0.75;
    box-shadow: 0 0 14px rgb(246 183 101 / 0.4);
  }
  @media (max-width: 420px) {
    .mc-band-actions :global(.btn) { flex: 1 1 100%; }
  }
</style>

<script>
  import { inView } from '@/lib/inview';

  const box = document.querySelector<HTMLElement>('[data-band]');
  const reduce = window.matchMedia?.('(prefers-reduced-motion: reduce)').matches;
  if (box && !reduce) {
    const slides = [...box.querySelectorAll<HTMLElement>('[data-slide]')];
    let k = 0;
    let timer: ReturnType<typeof setInterval> | undefined;
    const go = () => {
      slides[k].removeAttribute('data-active');
      k = (k + 1) % slides.length;
      slides[k].setAttribute('data-active', '');
    };
    let visible = false;
    const parallax = () => {
      if (!visible) return;
      const r = box.parentElement!.getBoundingClientRect();
      const p = (r.top + r.height / 2 - window.innerHeight / 2) / window.innerHeight;
      box.style.transform = `translate3d(0, ${(p * -8).toFixed(2)}%, 0)`;
    };
    inView(box.parentElement!, (v) => {
      visible = v;
      clearInterval(timer);
      if (v && slides.length > 1) timer = setInterval(go, 5000);
      parallax();
    });
    let ticking = false;
    window.addEventListener('scroll', () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => { ticking = false; parallax(); });
    }, { passive: true });
  }
</script>
