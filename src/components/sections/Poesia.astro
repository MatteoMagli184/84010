---
/**
 * ’A poesia: i versi in napoletano della seconda pagina del menù, in una
 * fascia centrata. Le strofe compaiono una dopo l'altra.
 */
import Container from '../ui/Container.astro';
import { poesia } from '@/data/menu';
import { poesiaIntro } from '@/data/content';
---
<section class="po" aria-label="Poesia in napoletano">
  <Container>
    <figure class="po-inner">
      <p class="kicker po-kicker">{poesiaIntro.kicker}</p>
      <blockquote class="po-verses" lang="nap">
        {poesia.map((strofa, i) => (
          <p class="po-strofa" data-reveal style={`--d:${i * 0.12}s`}>
            {strofa.map((v, k) => (
              <Fragment>{v}{k < strofa.length - 1 && <br />}</Fragment>
            ))}
          </p>
        ))}
      </blockquote>
      <figcaption class="po-sign">{poesiaIntro.sign}</figcaption>
    </figure>
  </Container>
</section>

<style>
  .po {
    position: relative;
    padding-block: var(--spacing-section);
    text-align: center;
  }
  .po::before {
    content: '';
    position: absolute;
    left: 50%;
    top: 0;
    width: min(28rem, 60vw);
    height: 1px;
    transform: translateX(-50%);
    background: var(--copper-line);
    opacity: 0.5;
  }
  .po-inner { margin: 0 auto; max-width: 40rem; }
  .po-kicker { justify-content: center; }
  .po-verses {
    margin: 2.5rem 0 0;
    display: flex;
    flex-direction: column;
    gap: 1.6rem;
  }
  .po-strofa {
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(1.15rem, 1.9vw, 1.45rem);
    line-height: 1.6;
    background-image: var(--copper-gradient);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    transition: opacity 1.1s var(--ease-out) var(--d, 0s);
  }
  .po-sign {
    margin-top: 2.5rem;
    font-size: 0.62rem;
    font-weight: 500;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--color-taupe);
  }
</style>
