---
/** La pizza (Servizi di mc8): due gruppi con scena e lista a icone. */
import Section from '../ui/Section.astro';
import Container from '../ui/Container.astro';
import Icon from '../ui/Icon.astro';
import Scene from '../Scene.astro';
import { pizza } from '@/data/content';
import { photos } from '@/data/photos';

const groupPhoto = { 'dal-forno': photos.fornoPizzeCottura, 'a-tavola': photos.pizzeFinestra } as const;
import { rich } from '@/lib/rich';
---
<Section id="la-pizza" label="La pizza">
  <Container>
    <div class="mc-sv-head">
      <p class="kicker">{pizza.kicker}</p>
      <h2 class="section-title" set:html={rich(pizza.title)} />
    </div>

    <div class="mc-sv-grid">
      {pizza.groups.map((g) => (
        <article class="mc-sv-group" id={g.id}>
          <div class="mc-sv-media" data-curtain>
            <Scene variant={g.scene} class="mc-sv-scene" caption={g.caption} photo={groupPhoto[g.id].src} alt={groupPhoto[g.id].alt} />
          </div>
          <h3 class="mc-sv-group-title">{g.title}</h3>
          <ul class="mc-sv-list">
            {g.items.map((it) => (
              <li class="mc-sv-item" data-reveal>
                <span class="mc-sv-ic"><Icon name={it.icon} size={22} stroke={1.5} /></span>
                <span>
                  <strong class="mc-sv-item-title">{it.title}</strong>
                  <span class="mc-sv-item-body">{it.body}</span>
                </span>
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </Container>
</Section>

<style>
  .mc-sv-head { max-width: 42rem; }
  .mc-sv-grid {
    margin-top: 3.5rem;
    display: grid;
    gap: 4rem 3rem;
  }
  @media (min-width: 900px) {
    .mc-sv-grid { grid-template-columns: 1fr 1fr; }
    .mc-sv-group:nth-child(2) { margin-top: 5rem; }
  }
  .mc-sv-group { scroll-margin-top: 6rem; }
  .mc-sv-media { border-radius: var(--radius-card); }
  .mc-sv-media :global(.mc-sv-scene) { width: 100%; aspect-ratio: 4 / 3; }
  .mc-sv-group-title {
    margin-top: 1.75rem;
    font-size: clamp(1.6rem, 2.6vw, 2.1rem);
    font-weight: 400;
    color: var(--color-sand);
  }
  .mc-sv-list { margin-top: 1rem; }
  .mc-sv-list .mc-sv-item {
    display: flex;
    gap: 1.1rem;
    align-items: flex-start;
    padding: 1.15rem 0;
    border-bottom: 1px solid var(--color-line);
    transition: padding-left 0.4s var(--ease-out), opacity 0.9s var(--ease-out);
  }
  .mc-sv-item:hover { padding-left: 0.5rem; }
  .mc-sv-ic {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    flex: 0 0 auto;
    border: 1px solid rgb(246 183 101 / 0.3);
    border-radius: 999px;
    color: var(--color-copper-light);
    transition: background 0.35s ease, color 0.35s ease, border-color 0.35s ease;
  }
  .mc-sv-item:hover .mc-sv-ic {
    background: linear-gradient(180deg, #f6b765, #be6f29);
    border-color: transparent;
    color: #1a0f08;
  }
  .mc-sv-item-title {
    display: block;
    padding-top: 0.15rem;
    font-weight: 600;
    color: var(--color-sand);
  }
  .mc-sv-item-body {
    display: block;
    margin-top: 0.2rem;
    font-size: 0.95rem;
    font-weight: 300;
    color: var(--color-muted);
  }
  @media (prefers-reduced-motion: reduce) {
    .mc-sv-item, .mc-sv-ic { transition: none; }
  }
</style>
