---
/**
 * Mappa Google del locale, veloce e senza pesare sull'apertura del sito:
 * - l'iframe parte solo quando la sezione si avvicina allo schermo
 *   (≈1200px prima), così è già pronta quando ci si arriva;
 * - nel frattempo si vede una cornice con la carta stropicciata e il segnaposto,
 *   poi la mappa entra in dissolvenza appena ha finito di caricare;
 * - nessuna chiave API: è l'embed pubblico di Google Maps.
 * I colori sono scuriti via CSS per stare con la palette del sito.
 */
import Icon from './ui/Icon.astro';
import { address, site } from '@/data/site';

const query = `${address.street}, ${address.postalCode} ${address.city} ${address.province}`;
const src = `https://www.google.com/maps?q=${encodeURIComponent(query)}&hl=it&z=16&output=embed`;
const title = `Mappa: ${site.name}, ${address.street}, ${address.city}`;
---
<figure class="map" data-map data-src={src}>
  <div class="map-placeholder" aria-hidden="true">
    <span class="map-pin"><Icon name="pin" size={26} stroke={1.5} /></span>
    <span class="map-loading">Caricamento mappa…</span>
  </div>

  <iframe
    data-map-frame
    title={title}
    loading="lazy"
    referrerpolicy="no-referrer-when-downgrade"
    allowfullscreen
  ></iframe>
  <noscript>
    <iframe src={src} title={title} loading="lazy" referrerpolicy="no-referrer-when-downgrade" style="opacity:1"></iframe>
  </noscript>

  <figcaption class="map-card">
    <span class="map-card-name">{site.name}</span>
    <span class="map-card-addr">{address.street}, {address.postalCode} {address.city}</span>
    <a href={address.mapsHref} target="_blank" rel="noopener" class="map-card-link">
      Apri in Google Maps <Icon name="arrow" size={14} />
    </a>
  </figcaption>
</figure>

<style>
  .map {
    position: relative;
    margin: 0;
    width: 100%;
    height: 100%;
    min-height: 26rem;
    overflow: hidden;
    border-radius: var(--radius-card);
    background: #17120e;
    box-shadow: 0 40px 80px -45px rgb(0 0 0 / 0.9), 0 0 0 1px rgb(246 183 101 / 0.18);
    isolation: isolate;
  }
  @media (max-width: 639px) {
    .map { min-height: 22rem; }
  }

  /* Cornice d'attesa */
  .map-placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.9rem;
    background:
      radial-gradient(40% 40% at 50% 45%, rgb(190 111 41 / 0.25), transparent 70%),
      linear-gradient(rgb(22 14 9 / 0.55), rgb(22 14 9 / 0.55)),
      url('/img/carta-stropicciata-m.webp') center / cover;
    transition: opacity 0.8s ease;
  }
  .map-pin {
    display: grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 999px;
    border: 1px solid rgb(246 183 101 / 0.4);
    color: var(--color-copper-light);
    animation: map-pulse 1.8s ease-in-out infinite;
  }
  @keyframes map-pulse {
    0%, 100% { box-shadow: 0 0 0 0 rgb(246 183 101 / 0.35); }
    50% { box-shadow: 0 0 0 14px rgb(246 183 101 / 0); }
  }
  .map-loading {
    font-size: 0.62rem;
    font-weight: 500;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--color-taupe);
  }

  /* Mappa: scurita e scaldata per stare con la palette */
  .map iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    opacity: 0;
    filter: invert(0.9) hue-rotate(180deg) sepia(0.35) saturate(0.75) brightness(0.92) contrast(0.92);
    transition: opacity 0.8s ease;
  }
  .map.is-ready iframe { opacity: 1; }
  .map.is-ready .map-placeholder { opacity: 0; pointer-events: none; }

  /* Scheda sul bordo della mappa */
  .map-card {
    position: absolute;
    z-index: 2;
    left: 1rem;
    bottom: 2.4rem; /* lascia visibile la riga di copyright di Google */
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    max-width: calc(100% - 2rem);
    padding: 1rem 1.25rem;
    border-radius: 0.9rem;
    background: rgb(22 14 9 / 0.86);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    box-shadow: 0 0 0 1px rgb(246 183 101 / 0.2), 0 20px 40px -20px rgb(0 0 0 / 0.8);
  }
  .map-card-name {
    font-family: var(--font-display);
    font-size: 1.2rem;
    color: var(--color-sand);
  }
  .map-card-addr { font-size: 0.85rem; color: var(--color-muted); }
  .map-card-link {
    margin-top: 0.45rem;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-copper-light);
  }
  .map-card-link :global(svg) { transition: transform 0.35s var(--ease-out); }
  .map-card-link:hover :global(svg) { transform: translateX(4px); }

  @media (prefers-reduced-motion: reduce) {
    .map-pin { animation: none; }
    .map iframe, .map-placeholder { transition: none; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-map]').forEach((box) => {
    const frame = box.querySelector<HTMLIFrameElement>('[data-map-frame]');
    const src = box.dataset.src;
    if (!frame || !src) return;
    let started = false;
    const start = () => {
      if (started) return;
      started = true;
      frame.addEventListener('load', () => box.classList.add('is-ready'), { once: true });
      // rete di sicurezza: se l'evento load non arriva, mostra comunque la mappa
      setTimeout(() => box.classList.add('is-ready'), 6000);
      frame.loading = 'eager';
      frame.src = src;
    };
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        (entries) => {
          if (entries.some((e) => e.isIntersecting)) {
            io.disconnect();
            start();
          }
        },
        { rootMargin: '1200px 0px' },
      );
      io.observe(box);
    } else {
      start();
    }
  });
</script>
