---
import Container from './ui/Container.astro';
import Logo from './ui/Logo.astro';
import Icon from './ui/Icon.astro';
import { site, contact, address, hours, closedLabel, social, legal, nav, waBooking } from '@/data/site';
import { hero } from '@/data/content';

interface Props {
  home?: boolean;
}
const { home = true } = Astro.props;
const to = (id: string) => (home ? `#${id}` : `/#${id}`);
const year = new Date().getFullYear();
---
<footer class="mc-footer">
  <Container wide>
    <div class="mc-footer-grid">
      <div class="mc-footer-brand">
        <a href={home ? '#top' : '/'} aria-label={`${site.name} — torna all'inizio`}>
          <Logo width={11} alt={site.name} />
        </a>
        <p class="mc-footer-claim">{hero.claimTop} {hero.claimBottom}</p>
      </div>

      <nav aria-label="Mappa del sito" class="mc-footer-col">
        <p class="mc-footer-label">Il sito</p>
        <ul class="mc-footer-list">
          {nav.map((item) => (
            <li><a href={to(item.id)} class="mc-footer-link">{item.label}</a></li>
          ))}
          <li><a href={to('domande')} class="mc-footer-link">Domande frequenti</a></li>
          <li><a href={waBooking} target="_blank" rel="noopener" class="mc-footer-link">Prenota un tavolo</a></li>
        </ul>
      </nav>

      <div class="mc-footer-col">
        <p class="mc-footer-label">Per info e prenotazioni</p>
        <ul class="mc-footer-list">
          <li>
            <a href={contact.whatsapp.href} target="_blank" rel="noopener" class="mc-contact"><Icon name="whatsapp" size={17} /><span>WhatsApp {contact.whatsapp.label}</span></a>
          </li>
          <li>
            <a href={contact.phone.href} class="mc-contact"><Icon name="phone" size={17} /><span>{contact.phone.label}</span></a>
          </li>
          <li>
            <a href={address.mapsHref} target="_blank" rel="noopener" class="mc-contact"><Icon name="pin" size={17} /><span>{address.street}<br />{address.postalCode} {address.city} ({address.province})</span></a>
          </li>
          {hours.length > 0 && (
            <li class="mc-contact mc-contact--static"><Icon name="clock" size={17} /><span>{hours.map((h) => `${h.label} ${h.opens}–${h.closes}`).join(' · ')}{closedLabel && ` · ${closedLabel}`}</span></li>
          )}
        </ul>
      </div>

      <div class="mc-footer-col">
        <p class="mc-footer-label">Seguici su</p>
        <div class="mc-footer-social">
          <a href={social.facebook.href} target="_blank" rel="noopener me" class="mc-social" aria-label="Facebook di 84010 Pizzeria">
            <Icon name="facebook" size={20} />
          </a>
          <a href={social.instagram.href} target="_blank" rel="noopener me" class="mc-social" aria-label="Instagram di 84010 Pizzeria">
            <Icon name="instagram" size={20} />
          </a>
        </div>
        <p class="mc-footer-ig">Facebook e Instagram</p>
      </div>
    </div>

    <span class="mc-footer-flag" aria-hidden="true"></span>

    <div class="mc-footer-bottom">
      <p>© {year} {legal.company}{legal.vat && ` — P.IVA ${legal.vat}`} · Pizzeria napoletana a Bologna</p>
      <p class="mc-footer-legal">
        <a href="/privacy/" class="mc-footer-link">Privacy</a>
        <a href="/cookie/" class="mc-footer-link">Cookie</a>
      </p>
      <p>
        Sito realizzato da <a href={legal.credit.href} target="_blank" rel="noopener" class="mc-footer-credit">{legal.credit.label}</a>
      </p>
    </div>
  </Container>
</footer>

<style>
  .mc-footer {
    background: rgb(20 13 9 / 0.95);
    color: var(--color-sand);
    padding: 4.5rem 0 2rem;
  }
  @media (max-width: 899px) {
    .mc-footer { padding-bottom: 6.5rem; }
  }
  .mc-footer-grid {
    display: grid;
    gap: 2.75rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 640px) {
    .mc-footer-grid { grid-template-columns: 1fr 1fr; }
  }
  @media (min-width: 1024px) {
    .mc-footer-grid { grid-template-columns: 1.4fr 0.8fr 1.3fr 0.9fr; }
  }
  .mc-footer-claim {
    margin-top: 1.5rem;
    max-width: 24ch;
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.3rem;
    line-height: 1.3;
    opacity: 0.85;
  }
  .mc-footer-label {
    margin-bottom: 1rem;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--color-copper-light);
  }
  .mc-footer-col { font-size: 0.92rem; }
  .mc-footer-list { display: flex; flex-direction: column; gap: 0.65rem; }
  .mc-footer-link { opacity: 0.8; transition: opacity 0.25s ease, color 0.25s ease; }
  .mc-footer-link:hover { opacity: 1; color: var(--color-copper-light); }
  .mc-footer-ig { margin-top: 0.85rem; font-size: 0.85rem; opacity: 0.7; }
  .mc-footer-credit { text-decoration: underline; text-underline-offset: 4px; }

  .mc-contact {
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
    width: fit-content;
    opacity: 0.85;
    overflow-wrap: anywhere;
    transition: opacity 0.25s ease, transform 0.3s var(--ease-out), color 0.25s ease;
  }
  .mc-contact :global(svg) { margin-top: 0.2rem; flex: 0 0 auto; color: var(--color-copper-light); }
  a.mc-contact:hover { opacity: 1; transform: translateX(3px); color: var(--color-copper-light); }
  .mc-contact--static { opacity: 0.7; }

  .mc-footer-social { display: flex; gap: 0.75rem; }
  .mc-social {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 0.7rem;
    background: linear-gradient(160deg, #ffd196 0%, #f6b765 22%, #be6f29 55%, #783b09 100%);
    color: #1a0f08;
    transition: transform 0.3s var(--ease-out), box-shadow 0.3s ease;
  }
  .mc-social:hover { transform: translateY(-4px); box-shadow: 0 10px 24px -10px rgb(246 183 101 / 0.7); }

  .mc-footer-flag {
    display: block;
    margin: 3.5rem auto 0;
    width: min(28rem, 70%);
    height: 2px;
    background: linear-gradient(90deg, transparent, #1f8a4c 15%, #1f8a4c 33%, #f3eee6 33%, #f3eee6 67%, #c8242f 67%, #c8242f 85%, transparent);
    opacity: 0.7;
  }
  .mc-footer-bottom {
    margin-top: 1.75rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--color-line);
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    font-size: 0.78rem;
    opacity: 0.75;
  }
  .mc-footer-legal { display: flex; flex-wrap: wrap; gap: 0.5rem 1.25rem; }
  @media (min-width: 900px) {
    .mc-footer-bottom { flex-direction: row; justify-content: space-between; align-items: center; }
  }
</style>
