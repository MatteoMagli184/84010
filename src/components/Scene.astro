---
/**
 * Scene: i riquadri «foto» del sito, disegnati in CSS/SVG sulle atmosfere del
 * moodboard (parete‑Vesuvio retroilluminata, nicchia ad arco, bocca del forno,
 * luce di candela) sopra la stessa carta stropicciata dello sfondo.
 * Quando arrivano le foto vere del locale basta passare `photo`: la scena
 * diventa una normale immagine ottimizzata, con la stessa cornice.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  variant: 'vesuvio' | 'arch' | 'oven' | 'candle';
  photo?: ImageMetadata;
  alt?: string;
  caption?: string;
  class?: string;
  /** Titolo/testo dentro la nicchia (solo variant="arch") */
  nicheTitle?: string;
  nicheText?: string;
  eager?: boolean;
}
const { variant, photo, alt = '', caption, class: cls = '', nicheTitle, nicheText, eager = false } = Astro.props;

// Profilo del Vesuvio ripreso dal contorno del logo (viewBox 545×140)
const ridge = 'M9 132 L225 31 L273 53 L321 31 L334 31 L345 38 L357 35 L530 132';
const embers = Array.from({ length: 14 }, (_, i) => ({
  x: 18 + ((i * 37) % 64),
  d: (i * 0.53) % 3.2,
  s: 2 + (i % 3),
}));
---
<div class:list={['scene', `scene--${variant}`, photo && 'scene--photo', cls]} data-scene>
  <div class="scene-inner">
    {photo ? (
      <Image src={photo} alt={alt} widths={[480, 800, 1200]} sizes="(min-width: 1024px) 50vw, 100vw" quality={78} loading={eager ? 'eager' : 'lazy'} class="scene-photo" />
    ) : (
      <Fragment>
        <span class="scene-tex" aria-hidden="true"></span>

        {variant === 'vesuvio' && (
          <svg class="scene-vesuvio" viewBox="0 0 545 140" preserveAspectRatio="xMidYMax meet" aria-hidden="true">
            <defs>
              <linearGradient id="sv-copper" x1="0" y1="0" x2="1" y2="0">
                <stop offset="0" stop-color="#944f18" />
                <stop offset=".42" stop-color="#ffd196" />
                <stop offset=".6" stop-color="#f6b765" />
                <stop offset="1" stop-color="#944f18" />
              </linearGradient>
              <filter id="sv-glow" x="-20%" y="-60%" width="140%" height="220%">
                <feGaussianBlur stdDeviation="7" />
              </filter>
            </defs>
            <path d={`${ridge} L545 140 L0 140 Z`} class="sv-mass" />
            <path d={ridge} class="sv-halo" filter="url(#sv-glow)" />
            <path d={ridge} class="sv-line" pathLength="1" />
          </svg>
        )}

        {variant === 'arch' && (
          <span class="scene-arch" aria-hidden="true">
            <span class="scene-arch-light"></span>
          </span>
        )}

        {variant === 'oven' && (
          <span class="scene-oven" aria-hidden="true">
            <span class="scene-oven-mouth">
              <span class="scene-oven-fire"></span>
              {embers.map((e) => <i style={`left:${e.x}%;animation-delay:-${e.d}s;width:${e.s}px;height:${e.s}px`}></i>)}
            </span>
          </span>
        )}

        {variant === 'candle' && (
          <span class="scene-candle" aria-hidden="true">
            <span class="scene-bokeh"></span>
            <span class="scene-candle-glow"></span>
            <span class="scene-candle-flame"></span>
            <span class="scene-candle-body"></span>
            <span class="scene-table"></span>
          </span>
        )}

        {(nicheTitle || nicheText) && (
          <span class="scene-niche-text">
            {nicheTitle && <span class="scene-niche-title copper">{nicheTitle}</span>}
            {nicheText && <span class="scene-niche-sub">{nicheText}</span>}
          </span>
        )}
      </Fragment>
    )}
  </div>
  {caption && <span class="scene-caption">{caption}</span>}
</div>

<style>
  .scene {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-card);
    background: #120d0a;
    isolation: isolate;
    box-shadow: 0 40px 80px -40px rgb(0 0 0 / 0.85), inset 0 0 0 1px rgb(246 183 101 / 0.12);
  }
  .scene-inner { position: absolute; inset: 0; }
  .scene-photo { width: 100%; height: 100%; object-fit: cover; }
  .scene-tex {
    position: absolute;
    inset: -4%;
    background: url('/img/carta-stropicciata-m.webp') center / cover;
    filter: brightness(0.55) sepia(0.35) saturate(1.2);
  }
  .scene-caption {
    position: absolute;
    left: 1.25rem;
    bottom: 1.1rem;
    z-index: 5;
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: var(--color-sand);
    opacity: 0.8;
  }

  /* ---------- Vesuvio retroilluminato (parete del moodboard) ---------- */
  .scene--vesuvio .scene-tex::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(60% 34% at 53% 64%, rgb(246 160 80 / 0.6), transparent 70%),
      radial-gradient(90% 60% at 50% 100%, rgb(190 111 41 / 0.25), transparent 70%);
    mix-blend-mode: screen;
  }
  .scene-vesuvio {
    position: absolute;
    left: -38%;
    bottom: -1px;
    width: 176%;
    height: auto;
    overflow: visible;
  }
  .sv-mass { fill: #0f0b08; opacity: 0.94; }
  .sv-halo { fill: none; stroke: #f6a058; stroke-width: 9; }
  .sv-line {
    fill: none;
    stroke: url(#sv-copper);
    stroke-width: 2.4;
    stroke-linejoin: round;
    stroke-linecap: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    transition: stroke-dashoffset 2.4s cubic-bezier(0.65, 0, 0.35, 1) 0.3s;
  }
  .sv-halo { opacity: 0; transition: opacity 1.6s ease 1.6s; }
  .scene.is-lit .sv-line { stroke-dashoffset: 0; }
  .scene.is-lit .sv-halo { opacity: 0.75; animation: sv-breathe 6s ease-in-out 3.2s infinite; }
  @keyframes sv-breathe {
    0%, 100% { opacity: 0.75; }
    50% { opacity: 0.45; }
  }

  /* ---------- Nicchia ad arco con luce dal basso ---------- */
  .scene-arch {
    position: absolute;
    left: 50%;
    bottom: 12%;
    width: 58%;
    height: 72%;
    transform: translateX(-50%);
    border-radius: 999px 999px 0.6rem 0.6rem;
    background: linear-gradient(180deg, #1c140f 0%, #2a1b12 60%, #3a2414 100%);
    box-shadow: inset 0 18px 40px rgb(0 0 0 / 0.7), inset 0 -2px 0 rgb(246 183 101 / 0.4), 0 0 0 1px rgb(246 183 101 / 0.12);
    overflow: hidden;
  }
  .scene-arch-light {
    position: absolute;
    inset: 0;
    background: radial-gradient(70% 55% at 50% 100%, rgb(246 170 95 / 0.65), transparent 70%);
  }
  .scene-niche-text {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 26%;
    z-index: 4;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
    padding: 0 22%;
    text-align: center;
  }
  .scene-niche-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2.2rem, 4.2vw, 3.2rem);
    line-height: 1;
    letter-spacing: 0.04em;
  }
  .scene-niche-sub {
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(1rem, 1.6vw, 1.2rem);
    line-height: 1.35;
    color: var(--color-sand);
    opacity: 0.88;
  }

  /* ---------- Bocca del forno ---------- */
  .scene-oven {
    position: absolute;
    left: 50%;
    bottom: -18%;
    width: 120%;
    aspect-ratio: 1.6;
    transform: translateX(-50%);
    border-radius: 50% 50% 0 0 / 70% 70% 0 0;
    background: radial-gradient(60% 70% at 50% 35%, #2a1a10, #120c08 70%);
    box-shadow: inset 0 2px 0 rgb(246 183 101 / 0.25);
  }
  .scene-oven-mouth {
    position: absolute;
    left: 50%;
    top: 34%;
    width: 46%;
    height: 34%;
    transform: translateX(-50%);
    border-radius: 999px 999px 0 0;
    overflow: hidden;
    background: #0a0604;
    box-shadow: 0 0 0 6px #1c120c, 0 0 60px 10px rgb(230 110 40 / 0.35);
  }
  .scene-oven-fire {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(55% 70% at 30% 100%, rgb(255 190 110 / 0.95), transparent 70%),
      radial-gradient(45% 60% at 72% 100%, rgb(240 120 40 / 0.9), transparent 70%),
      radial-gradient(90% 90% at 50% 110%, rgb(160 50 18 / 0.9), transparent 80%);
    animation: oven-flicker 3.4s ease-in-out infinite alternate;
  }
  .scene-oven-mouth i {
    position: absolute;
    bottom: 10%;
    border-radius: 50%;
    background: #ffcf8a;
    box-shadow: 0 0 6px 2px rgb(255 160 70 / 0.8);
    animation: ember 3.2s linear infinite;
    opacity: 0;
  }
  @keyframes oven-flicker {
    0% { opacity: 0.8; transform: scaleY(0.96); }
    40% { opacity: 1; transform: scaleY(1.03); }
    70% { opacity: 0.88; transform: scaleY(0.99); }
    100% { opacity: 1; transform: scaleY(1.05); }
  }
  @keyframes ember {
    0% { transform: translateY(0); opacity: 0; }
    15% { opacity: 1; }
    100% { transform: translateY(-140px) translateX(10px); opacity: 0; }
  }
  .scene--oven .scene-tex::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(60% 50% at 50% 70%, rgb(200 90 30 / 0.35), transparent 70%);
    mix-blend-mode: screen;
  }

  /* ---------- Candela sul tavolo ---------- */
  .scene-candle { position: absolute; inset: 0; }
  .scene-bokeh {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(4% 4% at 18% 30%, rgb(246 183 101 / 0.5), transparent),
      radial-gradient(6% 6% at 78% 22%, rgb(246 183 101 / 0.35), transparent),
      radial-gradient(5% 5% at 64% 40%, rgb(255 209 150 / 0.3), transparent),
      radial-gradient(3% 3% at 32% 18%, rgb(255 209 150 / 0.4), transparent),
      radial-gradient(7% 7% at 88% 48%, rgb(190 111 41 / 0.35), transparent);
    filter: blur(6px);
  }
  .scene-candle-glow {
    position: absolute;
    left: 50%;
    top: 52%;
    width: 80%;
    aspect-ratio: 1;
    transform: translate(-50%, -50%);
    background: radial-gradient(circle, rgb(255 190 110 / 0.45), rgb(190 111 41 / 0.15) 35%, transparent 65%);
    animation: candle-glow 2.6s ease-in-out infinite alternate;
  }
  .scene-candle-body {
    position: absolute;
    left: 50%;
    bottom: 26%;
    width: 16%;
    height: 17%;
    transform: translateX(-50%);
    border-radius: 0.5rem 0.5rem 0.3rem 0.3rem;
    background: linear-gradient(90deg, #0c0907, #2a211b 45%, #0c0907);
    box-shadow: inset 0 3px 0 rgb(255 200 130 / 0.35);
  }
  .scene-candle-flame {
    position: absolute;
    left: 50%;
    bottom: 42%;
    width: 2.6%;
    height: 7%;
    transform: translateX(-50%);
    border-radius: 50% 50% 50% 50% / 65% 65% 35% 35%;
    background: radial-gradient(60% 50% at 50% 70%, #fff3d6, #ffc46e 55%, rgb(240 120 40 / 0.6));
    box-shadow: 0 0 18px 6px rgb(255 180 90 / 0.55);
    animation: flame 1.8s ease-in-out infinite alternate;
    transform-origin: 50% 100%;
  }
  .scene-table {
    position: absolute;
    left: -5%;
    right: -5%;
    bottom: 0;
    height: 27%;
    background: linear-gradient(180deg, #1a130e, #0b0806);
    box-shadow: 0 -1px 0 rgb(246 183 101 / 0.25);
  }
  @keyframes flame {
    0% { transform: translateX(-50%) scale(1, 1) rotate(-2deg); }
    50% { transform: translateX(-50%) scale(0.92, 1.08) rotate(2deg); }
    100% { transform: translateX(-50%) scale(1.04, 0.95) rotate(-1deg); }
  }
  @keyframes candle-glow {
    from { opacity: 0.8; }
    to { opacity: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    .sv-line { stroke-dashoffset: 0; transition: none; }
    .sv-halo { opacity: 0.75; transition: none; }
    .scene-oven-fire, .scene-oven-mouth i, .scene-candle-flame, .scene-candle-glow { animation: none; }
  }
</style>

<script>
  import { inView } from '@/lib/inview';
  document.querySelectorAll<HTMLElement>('[data-scene]').forEach((el) => {
    inView(el, (v) => v && el.classList.add('is-lit'), true);
  });
</script>
